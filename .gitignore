# ── 密钥 ─────────────────────────────────────────────
# 前端 .env 与后端 .env 都走这个规则；.env.example 是唯一允许提交的
.env
.env.*
!.env.example
web/.env
web/.env.*
server/.env
server/.env.*
!web/.env.example
!server/.env.example

# ── Node / 前端 ──────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
web/dist/
web/dist-ssr/
web/node_modules/

# ── Maven / 后端 ─────────────────────────────────────
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war

# 前端构建产物嵌入后端的位置（pnpm build:embed 写这里）
server/src/main/resources/static/

# ── Python（抠图流水线）─────────────────────────────
.cutout-venv/
__pycache__/
*.pyc

# ── 日志与临时产物 ───────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
jmeter.log
.DS_Store

# ── 编辑器 ───────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.iml
.apt_generated
.classpath
.factorypath
.project
.settings
